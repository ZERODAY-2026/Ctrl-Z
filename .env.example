# Copy to .env and fill in. Never commit .env.

# --- Snowflake (required) ---
SNOWFLAKE_ACCOUNT=            # account identifier, e.g. myorg-myaccount
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_ROLE=DATAMIND_READER
# One of the following authentication methods:
SNOWFLAKE_PRIVATE_KEY_FILE=   # recommended: .secrets/datamind_rsa_key.p8 (scripts/generate_keypair.py)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=      # e.g. externalbrowser for SSO/MFA logins on your own machine

# --- Gemma (required) ---
GEMMA_PROVIDER=ollama         # ollama (verified) | google_ai_studio (optional)
GEMMA_MODEL=gemma4:e4b        # any Gemma tag in Ollama (needs Ollama >= 0.40 for Gemma 4), e.g. gemma3:4b, gemma2:9b
OLLAMA_HOST=http://localhost:11434
GEMMA_API_KEY=                # only for google_ai_studio
GEMMA_NUM_CTX=6144
GEMMA_TIMEOUT_S=180

# --- Dataset (config, not code) ---
DATAMIND_DATASET_CONFIG=datasets/tpch_sf1.toml
# DATAMIND_DATABASE=DATAMIND_DEMO   # optional override, e.g. the writable demo copy
# DATAMIND_SCHEMA=TPCH

# --- Limits ---
DATAMIND_MAX_ROWS=500
DATAMIND_STATEMENT_TIMEOUT_S=60

